<div class="mt-4">
    <form method="post" action="">
        <div class="mb-3">
            <label for="search-input" class="form-label">Từ khoá</label>
            <input name="q" type="text" class="form-control" id="search-input" placeholder="Nhập từ khoá....">
        </div>

        <div class="mb-3">
            <label for="gender-input" class="form-label">Giới tính</label>
            <select class="form-control" name="gender" id="gender-input">
                <option value="">-- Chọn giới tính</option>
                <option value="male">Nam</option>
                <option value="female">Nữ</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </form>
</div>