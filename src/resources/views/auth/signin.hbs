<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="/css/app.css">
</head>
<body>
    <div class="auth-container">
      <div class="auth-form">
          <div class="auth-form__message"><span>{{error}}</span></div>
          <h2 class="auth-form__title">Login</h2>
          <form action="/auth/sign-in/access" method="post">
            <div class="auth-form-group">
              <label for="email">Email:</label>
              <input type="email" id="email" name="email" placeholder="Enter your email" required>
            </div>
            <div class="auth-form-group">
              <label for="password">Password:</label>
              <input type="password" id="password" name="password" placeholder="Enter your password" required autocomplete="off">
            </div>
            <button type="submit" class="auth-form__submit-btn">Login</button>
          </form>
          <p class="auth-form__footer">Don't have an account? <a class="link" href="/auth/sign-up">SignUp</a></p>
      </div>
    </div>
</body>
</html>
