<div class="mt-4">
    <div class="row">
        {{#courses}}
            <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="card card-course-item" style="width: 18rem;">
                        <a href="/courses/{{this.slug}}"><img src="{{this.image}}" class="card-img-top" alt="{{this.name}}"></a>
                        <div class="card-body">
                            <a class="card-link" href="/courses/{{this.slug}}"><h5 class="card-title">{{this.name}}</h5></a>
                            <p class="card-text">{{this.description}}</p>
                            <a href="#" class="btn btn-primary">Mua khoá học</a>
                        </div>
                    </div>
            </div>
        {{/courses}}
    </div>
</div>