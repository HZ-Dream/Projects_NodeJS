<form name="container-form" method="POST" class="mt-4" action="/courses/handle-form-actions">
    <div>
        <h3>Danh sách khoá học đã xoá</h3>
        <a class="btn btn-info" href="/me/stored/courses"><i class="fas fa-undo-alt"></i>Quay lại khoá học</a>
    
        <div class="mt-4 d-flex align-items-center">
          <select class="form-select form-select-sm selectAll-options" aria-label="Default select example" name="action" required>
              <option value="" selected>--- Chọn hành động ---</option>
              <option value="restore">Khôi phục</option>
              <option value="force-delete">Xoá vĩnh viễn</option>
          </select>

          <button class="btnExecute btn btn-primary btn-sm disabled">Thực hiện</button>
        </div>
    </div>

    <table class="table mt-4">
        <thead>
            <tr>
            <th scope="col">
              <input class="form-check-input" type="checkbox" value="" id="checkbox-all"> All
            </th>
            <th scope="col">#</th>
            <th scope="col">Tên khoá học
            {{{sortable 'name' _sort}}}
            </th>
            <th scope="col">Trình độ
            {{{sortable 'level' _sort}}}
            </th>
            <th scope="col">Thời gian xoá
            {{{sortable 'deletedAt' _sort}}}
            </th>
            <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            {{#courses}}
            <tr>
                <td>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="courseIds[]" value="{{this._id}}">
                    </div>
                </td>
                <th scope="row">{{sum @index 1}}</th>
                <td>{{this.name}}</td>
                <td>{{this.level}}</td>
                <td>{{formatDate this.deletedAt}}</td>
                <td>
                    <a href="" class="btn btn-primary btnRestore" data-id="{{this._id}}">Khôi phục</a>
                    <a href="#" class="btn btn-primary" data-id="{{this._id}}" data-bs-toggle="modal" data-bs-target="#delete-course-modal">Xoá</a>
                </td>
            </tr>

            {{else}}
            <tr>
                <td colspan="5" class="text-center">Không có khoá học nào đã xoá</td>
            </tr>
            {{/courses}}
        </tbody>
    </table>
</form>

{{!-- Confirm Delete --}}
<div id="delete-course-modal" class="modal mt-5" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">XOÁ KHOÁ HỌC VĨNH VIỄN</h5>
        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p>Bạn có chắc muốn xoá khoá học này vĩnh viễn không?</p>
      </div>
      <div class="modal-footer">
        <button id="btnDelete-course" type="button" class="btn btn-danger">Xoá</button>
        <button type="button" class="btn btn-secondary close" data-bs-dismiss="modal">Huỷ</button>
      </div>
    </div>
  </div>
</div>

{{!-- Hidden Form --}}
<form name="formDelete" method="POST"></form>
<form name="formRestore" method="POST"></form>

<script>
    document.addEventListener('DOMContentLoaded', function () {
      var courseId;
      var formDelete = document.forms['formDelete'];
      var formRestore = document.forms['formRestore'];
      var containerForm = $('form[name="container-form"]');
      var btnDelete = document.getElementById('btnDelete-course');
      var btnRestore = $('.btnRestore');
      var checkboxAll = $('#checkbox-all');
      var courseItemCheckbox = $('input[name="courseIds[]"]');
      var btnExecute = $('.btnExecute');

      $('#delete-course-modal').on('show.bs.modal', function (event) {
          var button = $(event.relatedTarget);
          courseId = button.data('id');
      });

      btnDelete.addEventListener('click', function () {
          formDelete.action = '/courses/' + courseId + '/force/?_method=DELETE';
          formDelete.submit();
      });

      btnRestore.click(function (event) {
          event.preventDefault();
            
          courseId = $(this).data('id');
          formRestore.action = '/courses/' + courseId + '/restore/?_method=PATCH';
          formRestore.submit();
        });

      checkboxAll.change(function () {
            let isChecked = $(this).prop('checked');
            courseItemCheckbox.prop('checked', isChecked);
            updateButtonState();
        });

      courseItemCheckbox.change(function () {
          let isCheckedAll = courseItemCheckbox.length === $('input[name="courseIds[]"]:checked').length;
          checkboxAll.prop('checked', isCheckedAll);  
          updateButtonState();
      });

      function updateButtonState() {
        let countChecked = $('input[name="courseIds[]"]:checked').length;
        if (countChecked > 0) {
            btnExecute.removeClass('disabled');
        } else {
            btnExecute.addClass('disabled');
        }
      }

      containerForm.on('submit', (function (e) {
          let isSubmitted = btnExecute.hasClass('disabled');
          if (isSubmitted) {
              e.preventDefault();
              return;
          }
      }));
  });
</script>